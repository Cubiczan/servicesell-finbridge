{
  "name": "servicesell-finbridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Cubiczan dual-brand Anna App: ServiceSell + FinBridge on one CHP spine.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43173",
    "test": "vitest run && npm run test:engine",
    "test:engine": "python3 executas/servicesell-finbridge/test_engine.py",
    "validate": "anna-app validate",
    "validate:strict": "anna-app validate --strict",
    "anna:dev": "anna-app dev --port 43180",
    "anna:doctor": "anna-app doctor"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@anna-ai/cli": "^0.1.52",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
